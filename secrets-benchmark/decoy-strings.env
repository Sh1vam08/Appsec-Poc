# BENCH-SECRET-032: High-entropy decoy strings (False Positive test)
# Tests: False positive reduction (secret-specific)
#
# These are randomly generated strings that LOOK like API keys or tokens
# but are NOT real secrets. If the scanner flags them, it's a False Positive.

# Decoy 1: Looks like an API key but is just a random hex string used for CSS colors
COLOR_PALETTE_HASH=a3f8b2c1d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9
THEME_SIGNATURE=7c4a8d09ca3762af61e59520943dc26494f8941b

# Decoy 2: Looks like a JWT but is actually a static test fixture
TEST_FIXTURE_TOKEN=eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJ0ZXN0IjoidGhpcyBpcyBhIHRlc3QgZml4dHVyZSJ9.

# Decoy 3: Looks like a cloud key but is a configuration hash
CONFIG_CHECKSUM=AKIA0000000000DECOY0
BUILD_HASH=wDecoyNotARealSecretKeyJustABuildHash000

# Decoy 4: Random high-entropy string used for cache busting
CACHE_BUSTER=x9k2m4p7q1r3t6v8w0y5z
ASSET_FINGERPRINT=sha256-5f3c8b2e1d4a7f9e0c6b3d8a1e4f7c2b5d8a3e6f
