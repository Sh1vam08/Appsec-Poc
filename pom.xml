<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         Enterprise AppSec Benchmark Suite
         Phase 2: Core Spring Boot Skeleton POM
         NOTE: Intentionally vulnerable dependencies will be added in Phase 5 (SCA Benchmark).
               This POM contains SAFE dependency versions for the skeleton only.
         WARNING: This application is intentionally vulnerable. DO NOT deploy to production.
         ============================================================ -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.1</version>
        <relativePath/>
    </parent>

    <groupId>com.shopsphere</groupId>
    <artifactId>appsec-benchmark</artifactId>
    <version>1.0.0-BENCHMARK</version>
    <packaging>jar</packaging>

    <name>ShopSphere E-Commerce Platform</name>
    <description>
        Enterprise-grade Application Security Benchmark Suite for evaluating AppSec platforms.
        Contains intentional security vulnerabilities for testing purposes.
        DO NOT deploy to production environments.
    </description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Safe dependency versions for skeleton (Phase 2) -->
        <!-- SCA benchmark dependencies with CVEs are added in Phase 5 -->
        <springdoc.version>2.3.0</springdoc.version>
        <jjwt.version>0.12.3</jjwt.version>
        <owasp-encoder.version>1.2.3</owasp-encoder.version>
        <commons-lang3.version>3.14.0</commons-lang3.version>

        <!-- ============================================================
             SCA BENCHMARK DEPENDENCIES (Phase 5) — INTENTIONALLY VULNERABLE
             These are added here with pinned vulnerable versions:
             BENCH-SCA-001: log4j-core 2.14.1 (CVE-2021-44228 - Log4Shell)
             BENCH-SCA-002: jackson-databind 2.9.8 (CVE-2019-12086)
             BENCH-SCA-003: snakeyaml 1.26 (CVE-2022-1471)
             BENCH-SCA-004: commons-collections 3.2.1 (CVE-2015-6420)
             BENCH-SCA-005: spring-core 5.3.17 (CVE-2022-22965 - Spring4Shell)
             BENCH-SCA-006: commons-text 1.9 (CVE-2022-42889 - Text4Shell)
             BENCH-SCA-007: httpclient 4.5.6 (CVE-2020-13956)
             BENCH-SCA-008: bcprov-jdk15on 1.60 (CVE-2020-28052)
             BENCH-SCA-009: hibernate-validator 6.0.0.Final (CVE-2020-10693)
             BENCH-SCA-010: guava 29.0-jre (CVE-2020-8908)
             ============================================================ -->
        <log4j.vulnerable.version>2.14.1</log4j.vulnerable.version>
        <jackson.vulnerable.version>2.9.8</jackson.vulnerable.version>
        <snakeyaml.vulnerable.version>1.26</snakeyaml.vulnerable.version>
        <commons-collections.vulnerable.version>3.2.1</commons-collections.vulnerable.version>
        <spring-core.vulnerable.version>5.3.17</spring-core.vulnerable.version>
        <commons-text.vulnerable.version>1.9</commons-text.vulnerable.version>
        <httpclient.vulnerable.version>4.5.6</httpclient.vulnerable.version>
        <bcprov.vulnerable.version>1.60</bcprov.vulnerable.version>
        <hibernate-validator.vulnerable.version>6.0.0.Final</hibernate-validator.vulnerable.version>
        <guava.vulnerable.version>29.0-jre</guava.vulnerable.version>
    </properties>

    <dependencies>
        <!-- ============================================================
             CORE SPRING BOOT DEPENDENCIES (Safe versions)
             ============================================================ -->

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring Boot Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Boot Thymeleaf (for XSS benchmark scenarios) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Spring Security Thymeleaf Integration -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Boot Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- H2 Embedded Database -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- SpringDoc OpenAPI (Swagger UI) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- JWT Library (safe version for skeleton auth) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- OWASP Java Encoder (for safe XSS scenarios) -->
        <dependency>
            <groupId>org.owasp.encoder</groupId>
            <artifactId>encoder</artifactId>
            <version>${owasp-encoder.version}</version>
        </dependency>

        <!-- Apache Commons Lang3 (safe version) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>

        <!-- MongoDB Sync Driver (for NoSQL Injection benchmark) -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Dev Tools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security Test -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================
             SCA BENCHMARK DEPENDENCIES — INTENTIONALLY VULNERABLE
             Added for Phase 5 SCA benchmark scenarios.
             These versions contain known CVEs that scanners must detect.
             DO NOT upgrade these versions — they are benchmark fixtures.
             ============================================================ -->

        <!-- BENCH-SCA-001: Log4Shell — CVE-2021-44228 (CRITICAL) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.vulnerable.version}</version>
            <!-- BENCH-SCA-001: Direct dependency — CVE-2021-44228 -->
        </dependency>

        <!-- BENCH-SCA-002: Jackson Deserialization — CVE-2019-12086 (HIGH) (Declared in sca-vulnerability-fixtures profile to prevent runtime class mismatches) -->


        <!-- BENCH-SCA-003: SnakeYAML RCE — CVE-2022-1471 (CRITICAL) -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>${snakeyaml.vulnerable.version}</version>
            <!-- BENCH-SCA-003: Direct dependency — CVE-2022-1471 -->
        </dependency>

        <!-- BENCH-SCA-004: Commons Collections Gadget Chain — CVE-2015-6420 (CRITICAL) -->
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>${commons-collections.vulnerable.version}</version>
            <!-- BENCH-SCA-004: Direct dependency — CVE-2015-6420 -->
        </dependency>

        <!-- BENCH-SCA-005: Spring4Shell — CVE-2022-22965 (CRITICAL) -->
        <!-- Note: spring-core is provided by spring-boot-starter-parent at safe version -->
        <!-- The vulnerable spring-core is referenced as a provided dep for SCA detection -->
        <!-- In a real SCA test, one would override the managed version -->

        <!-- BENCH-SCA-006: Text4Shell — CVE-2022-42889 (CRITICAL) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>${commons-text.vulnerable.version}</version>
            <!-- BENCH-SCA-006: Direct dependency — CVE-2022-42889 -->
        </dependency>

        <!-- BENCH-SCA-007: Apache HttpClient URI — CVE-2020-13956 (MEDIUM) -->
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <version>${httpclient.vulnerable.version}</version>
            <!-- BENCH-SCA-007: Direct dependency — CVE-2020-13956 -->
        </dependency>

        <!-- BENCH-SCA-008: Bouncy Castle Auth Bypass — CVE-2020-28052 (HIGH) -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk15on</artifactId>
            <version>${bcprov.vulnerable.version}</version>
            <!-- BENCH-SCA-008: Direct dependency — CVE-2020-28052 -->
        </dependency>

        <!-- BENCH-SCA-009: Hibernate Validator — CVE-2020-10693 (MEDIUM) -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>${hibernate-validator.vulnerable.version}</version>
            <!-- BENCH-SCA-009: Direct dependency — CVE-2020-10693 -->
        </dependency>

        <!-- BENCH-SCA-010: Guava Temp Dir — CVE-2020-8908 (LOW) -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.vulnerable.version}</version>
            <!-- BENCH-SCA-010: Direct dependency — CVE-2020-8908 -->
        </dependency>

        <!-- BENCH-SCA-011: Restrictive License (AGPL) to test License Compliance -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.5.13.3</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-opens java.base/java.lang=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>sca-vulnerability-fixtures</id>
            <dependencies>
                <!-- BENCH-SCA-002: Jackson Deserialization — CVE-2019-12086 (HIGH) -->
                <dependency>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-databind</artifactId>
                    <version>${jackson.vulnerable.version}</version>
                    <!-- BENCH-SCA-002: Direct dependency — CVE-2019-12086 -->
                </dependency>
                <!-- BENCH-SCA-011: Restrictive License (AGPL) to test License Compliance -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.5.13.3</version>
        </dependency>
    </dependencies>
        </profile>
    </profiles>

</project>
