{
  "schema_version": "1.0.0",
  "last_updated": "2026-06-23T17:35:00+05:30",
  "description": "Executive dashboard data schema. Defines the structure of all dashboard data feeds consumed by the frontend.",
  "dashboard_schema": {
    "summary_card": {
      "description": "Top-level KPI cards showing headline metrics for quick consumption",
      "file": "dashboard-data/summary_card.json",
      "schema": {
        "type": "object",
        "properties": {
          "vendor": { "type": "string", "description": "Name of the evaluated vendor" },
          "generated_at": { "type": "string", "format": "date-time", "description": "ISO 8601 timestamp" },
          "composite_score": { "type": "number", "minimum": 0, "maximum": 100, "description": "Weighted composite score" },
          "grade": { "type": "string", "enum": ["A+", "A", "A-", "B+", "B", "B-", "C+", "C", "D", "F"], "description": "Letter grade" },
          "total_evaluated": { "type": "integer", "description": "Number of benchmarks evaluated" },
          "headline_metrics": {
            "type": "object",
            "properties": {
              "precision": { "type": "number", "minimum": 0, "maximum": 1 },
              "recall": { "type": "number", "minimum": 0, "maximum": 1 },
              "f1_score": { "type": "number", "minimum": 0, "maximum": 1 },
              "accuracy": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      },
      "visualization": {
        "type": "kpi_cards",
        "layout": "horizontal",
        "cards": [
          { "label": "Composite Score", "field": "composite_score", "format": "score", "color_coding": "grade_based" },
          { "label": "Grade", "field": "grade", "format": "text", "color_coding": "grade_based" },
          { "label": "Precision", "field": "headline_metrics.precision", "format": "percentage" },
          { "label": "Recall", "field": "headline_metrics.recall", "format": "percentage" },
          { "label": "F1 Score", "field": "headline_metrics.f1_score", "format": "percentage" }
        ]
      }
    },
    "radar_chart": {
      "description": "Radar/spider chart showing F1 scores per security testing category",
      "file": "dashboard-data/radar_chart.json",
      "schema": {
        "type": "object",
        "properties": {
          "labels": { "type": "array", "items": { "type": "string" }, "description": "Category names" },
          "values": { "type": "array", "items": { "type": "number" }, "description": "F1 scores per category" }
        }
      },
      "visualization": {
        "type": "radar",
        "scale": { "min": 0, "max": 1 },
        "fill": true,
        "fill_opacity": 0.25,
        "line_color": "#4f46e5",
        "point_style": "circle"
      }
    },
    "confusion_heatmap": {
      "description": "2x2 heatmap of the confusion matrix",
      "file": "dashboard-data/confusion_heatmap.json",
      "schema": {
        "type": "object",
        "properties": {
          "matrix": { "type": "array", "description": "2x2 matrix [[TP, FN], [FP, TN]]" },
          "row_labels": { "type": "array", "items": { "type": "string" } },
          "col_labels": { "type": "array", "items": { "type": "string" } }
        }
      },
      "visualization": {
        "type": "heatmap",
        "color_scale": ["#22c55e", "#ef4444"],
        "annotations": true,
        "cell_size": 120
      }
    },
    "category_bars": {
      "description": "Grouped bar chart comparing precision, recall, and F1 across categories",
      "file": "dashboard-data/category_bars.json",
      "schema": {
        "type": "object",
        "properties": {
          "categories": { "type": "array", "items": { "type": "string" } },
          "precision": { "type": "array", "items": { "type": "number" } },
          "recall": { "type": "array", "items": { "type": "number" } },
          "f1": { "type": "array", "items": { "type": "number" } }
        }
      },
      "visualization": {
        "type": "grouped_bar",
        "colors": {
          "precision": "#3b82f6",
          "recall": "#10b981",
          "f1": "#f59e0b"
        },
        "y_axis": { "label": "Score", "min": 0, "max": 1 },
        "x_axis": { "label": "Category" }
      }
    },
    "ai_capability_spider": {
      "description": "Spider chart showing AI feature evaluation scores",
      "file": "dashboard-data/ai_capability_spider.json",
      "schema": {
        "type": "object",
        "properties": {
          "labels": { "type": "array", "items": { "type": "string" }, "description": "AI capability names" },
          "scores": { "type": "array", "items": { "type": "number" }, "description": "Scores (0-1)" }
        }
      },
      "visualization": {
        "type": "radar",
        "scale": { "min": 0, "max": 1 },
        "fill": true,
        "fill_opacity": 0.20,
        "line_color": "#8b5cf6",
        "point_style": "diamond"
      }
    },
    "cwe_treemap": {
      "description": "Treemap showing per-CWE detection performance sized by benchmark count",
      "file": "dashboard-data/cwe_treemap.json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "cwe": { "type": "string" },
            "total": { "type": "integer" },
            "f1": { "type": "number" },
            "precision": { "type": "number" },
            "recall": { "type": "number" }
          }
        }
      },
      "visualization": {
        "type": "treemap",
        "size_field": "total",
        "color_field": "f1",
        "color_scale": { "low": "#ef4444", "mid": "#f59e0b", "high": "#22c55e" },
        "label_field": "cwe"
      }
    }
  },
  "refresh_policy": {
    "auto_refresh": false,
    "manual_trigger": "Re-run kpi_calculator.py with updated scan results",
    "history_tracking": {
      "enabled": true,
      "storage": "reports/history/",
      "max_snapshots": 50,
      "format": "timestamped_json"
    }
  }
}
