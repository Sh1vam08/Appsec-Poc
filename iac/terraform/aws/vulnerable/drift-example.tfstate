{
  "version": 4,
  "terraform_version": "1.5.0",
  "serial": 1,
  "lineage": "drift-example",
  "outputs": {},
  "resources": [
    {
      "mode": "managed",
      "type": "aws_db_instance",
      "name": "drift_example_rds",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "identifier": "drift-example-db",
            "allocated_storage": 20,
            "engine": "mysql",
            "engine_version": "8.0",
            "instance_class": "db.t3.micro",
            "db_name": "driftdb",
            "username": "admin",
            "password": "DriftExamplePass!",
            "publicly_accessible": true,
            "storage_encrypted": false,
            "endpoint": "drift-example-db.abc123.us-east-1.rds.amazonaws.com:3306"
          }
        }
      ]
    }
  ]
}
