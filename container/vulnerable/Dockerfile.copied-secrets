# BENCH-CONT-012: Secrets copied into container image via files
# Tests: Secrets detection in container images
# Unlike ENV-based secrets, these are COPY'd files baked into the image layers.

FROM alpine:3.18

WORKDIR /app

# Copy a .env file containing secrets directly into the image
COPY secrets.env /app/.env

# Copy SSH keys into the image
RUN mkdir -p /root/.ssh
RUN echo "-----BEGIN RSA PRIVATE KEY-----" > /root/.ssh/id_rsa && \
    echo "MIIEogIBAAKCAQEAt3c6GgK1L2M3N4O5P6Q7R8S9T0U1V2W3X4Y5Z6" >> /root/.ssh/id_rsa && \
    echo "-----END RSA PRIVATE KEY-----" >> /root/.ssh/id_rsa && \
    chmod 600 /root/.ssh/id_rsa

# Bake a secret via ARG that gets persisted in the layer
ARG DB_PASSWORD=SuperSecretPassword123!
RUN echo "db.password=$DB_PASSWORD" > /app/database.properties

ENTRYPOINT ["/bin/sh"]
